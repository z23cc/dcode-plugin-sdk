// A tour of less common node shapes.
digraph shapes {
  d [shape=diamond label="diamond"];
  e [shape=ellipse label="ellipse"];
  p [shape=plaintext label="plaintext"];
  h [shape=hexagon label="hexagon"];
  t [shape=triangle label="triangle"];
  c [shape=cylinder label="cylinder"];
  d -> e -> p;
  d -> h -> t;
  e -> c;
}
